# syntax=docker/dockerfile:1
#
# Hushloom worker: the BullMQ generation worker (src/worker/index.ts), run from source with tsx as
# `npm run worker` does. The same image runs the one-shot jobs in docker-compose.yml: migrations
# (npm run db:migrate), the optional seed (npm run db:seed) and the optional S3 bucket check.
#
#   docker build -f Dockerfile.worker -t hushloom-worker .

ARG NODE_IMAGE=node:22-bookworm-slim

FROM ${NODE_IMAGE}
# ffmpeg renders the labeled demo clips, extracts poster frames and pulls keyframes for the abuse scan.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
# Dev dependencies stay: tsx runs the TypeScript sources (worker, migrations, seed).
RUN --mount=type=cache,target=/root/.npm npm ci --no-audit --no-fund
COPY . .
# Local media lives on a volume shared with the web app at the same absolute path.
RUN mkdir -p /data/storage && chown node:node /data/storage
# NODE_ENV=production makes this a live site unless APP_ENV says otherwise; see .env.example.
ENV NODE_ENV=production \
    STORAGE_LOCAL_DIR=/data/storage \
    WORKER_HEALTH_PORT=3901
USER node
VOLUME ["/data/storage"]
EXPOSE 3901
# The worker's liveness endpoint answers 200 while its BullMQ consumer is running.
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:'+(process.env.WORKER_HEALTH_PORT||3901)+'/health').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"]
# node itself is PID 1 (no npm or tsx wrapper), so SIGTERM reaches the worker's graceful shutdown.
CMD ["node", "--import", "tsx", "src/worker/index.ts"]
