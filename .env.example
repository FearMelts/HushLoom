# Hushloom environment template.
#
# Copy to .env and uncomment only what you set. Every variable the app reads is listed here, grouped
# as in src/server/env.ts (the source of truth: types, defaults and the production checks live there).
# A value shown after "=" is the built-in default, so a commented line already behaves that way.
# Leave unused lines commented: an empty value is not the same as unset and fails validation for
# several variables. Never commit .env, and never put a real key in this file.
#
# Secrets: generate with `openssl rand -hex 32` (hex keeps them safe inside URLs and docker compose).
#
# Who reads .env: `npm run dev` and `npm start` load it automatically; docker compose passes it to
# every container. The worker, migrations and seed (tsx scripts) do not: export it first, for
# example `set -a; . ./.env; set +a`, or rely on the defaults.

# ── Deployment ─────────────────────────────────────────────────────────────────────────────────────

# Set by the tooling: next dev = development, next build/start and the Docker images = production.
# NODE_ENV=development

# What kind of site this is. Unset on a live site: a production build without APP_ENV is live, and on
# a live site sandbox payments, the sandbox age check and the development scanner refuse to run.
# "staging" is for a private preview only (sandboxes allowed); "test" is what the e2e suite uses.
# Never set it on a public site.
# APP_ENV=

# The public origin users reach (https in production); also accepted as an origin for API writes.
# APP_URL=http://localhost:3000

# Postgres connection string.
# DATABASE_URL=postgres://playbox@localhost:5432/playbox

# Redis connection string (BullMQ queue and rate limits; needs persistence and no eviction).
# REDIS_URL=redis://localhost:6379

# How long a sign-in lasts, in days.
# SESSION_TTL_DAYS=30

# Signs private media links. Required in production, 32+ characters: generate with openssl rand -hex 32.
# MEDIA_SIGNING_SECRET=

# Lifetime of a signed link to private media, in seconds.
# MEDIA_URL_TTL_S=300

# ── Storage ────────────────────────────────────────────────────────────────────────────────────────

# "local" (files on disk, served through /api/media) or "s3" (any S3-compatible service).
# STORAGE_DRIVER=local

# Local media folder. Must be absolute in production, and the same path for the web app and the
# worker (the Docker images use /data/storage on a shared volume).
# STORAGE_LOCAL_DIR=.storage

# S3: bucket name; required when STORAGE_DRIVER=s3. Keep the bucket private.
# S3_BUCKET=

# S3: region ("auto" when unset, which suits Cloudflare R2).
# S3_REGION=

# S3: endpoint for non-AWS services (R2, MinIO). Browsers fetch presigned links from it directly.
# S3_ENDPOINT=

# S3: access key id. Secret store only.
# S3_ACCESS_KEY_ID=

# S3: secret access key. Secret store only.
# S3_SECRET_ACCESS_KEY=

# ── AI generation ──────────────────────────────────────────────────────────────────────────────────

# The labeled demo models: ffmpeg and sharp render a placeholder marked as a demo; no AI is called.
# ENABLE_DEMO_PROVIDER=true

# Replicate API token for the replicate-flux-schnell adapter (never run against Replicate).
# REPLICATE_API_TOKEN=

# Replicate webhook signing secret; the webhook answers 503 without it (it only records status).
# REPLICATE_WEBHOOK_SECRET=

# Seconds before a provider call counts as timed out.
# PROVIDER_TIMEOUT_S=600

# ── Worker and limits ──────────────────────────────────────────────────────────────────────────────

# Jobs one worker process runs at once.
# WORKER_CONCURRENCY=2

# Port for the worker's GET /health liveness endpoint; off when unset (the worker image sets 3901).
# WORKER_HEALTH_PORT=

# Generations one user may have queued or running at once (a paid plan can raise it).
# USER_MAX_ACTIVE_JOBS=3

# Credits granted to every new account.
# SIGNUP_GRANT_CREDITS=0

# ── Age gate and geolocation ───────────────────────────────────────────────────────────────────────

# Extra comma-separated country codes that require a provider-backed age check (folded into the rules).
# AGE_ASSURANCE_STRICT_REGIONS=

# Request header carrying the visitor's country (for example cf-ipcountry behind Cloudflare). The edge
# must set it and strip any copy the client sends: the app trusts it as received.
# GEO_COUNTRY_HEADER=x-country-code

# Request header carrying the US state or region code (for example "TX"); same edge rule as above.
# GEO_REGION_HEADER=x-region-code

# ── Payments (addendum §1) ─────────────────────────────────────────────────────────────────────────

# "sandbox" (labeled, never charges, refused on a live site), "ccbill", "segpay" or "stripe".
# Stripe bans adult content (https://stripe.com/legal/restricted-businesses): keep it off for this app.
# PAYMENT_PROVIDER=sandbox

# CCBill: client account number.
# CCBILL_ACCOUNT=

# CCBill: client subaccount number.
# CCBILL_SUBACCOUNT=

# CCBill: FlexForm id used for checkout.
# CCBILL_FLEXFORM_ID=

# CCBill: Dynamic Pricing salt (signs checkout links and verifies sale digests). Secret.
# CCBILL_SALT=

# CCBill: shared token appended to the registered webhook URL (?token=...), 16+ characters. Generate it.
# CCBILL_WEBHOOK_TOKEN=

# CCBill: DataLink user (declared for refunds and cancellations; not used by this build).
# CCBILL_DATALINK_USER=

# CCBill: DataLink password (declared; not used by this build). Secret.
# CCBILL_DATALINK_PASSWORD=

# Segpay: package id.
# SEGPAY_PACKAGE_ID=

# Segpay: one price point per pack and plan, such as pack_small=12345,plan_member=12346 (no shared fallback).
# SEGPAY_PRICE_POINT_ID=

# Segpay: user access key (an accepted postback password). Secret.
# SEGPAY_USER_ACCESS_KEY=

# Segpay: postback secret every postback must present. Secret.
# SEGPAY_POSTBACK_SECRET=

# Stripe: secret key, used only when PAYMENT_PROVIDER=stripe. Secret.
# STRIPE_SECRET_KEY=

# Stripe: webhook signing secret, used only when PAYMENT_PROVIDER=stripe. Secret.
# STRIPE_WEBHOOK_SECRET=

# ── Age verification (addendum §2) ─────────────────────────────────────────────────────────────────

# "sandbox" (labeled, proves nothing, refused on a live site while enforcing) or "yoti".
# AGE_VERIFICATION_PROVIDER=sandbox

# Block users in covered places from generating, uploading and seeing explicit media until verified.
# AGE_VERIFICATION_ENFORCE=true

# Comma-separated override of the covered places (defaults: GB and US states, src/config/jurisdictions.ts).
# AGE_VERIFICATION_REGIONS=

# When no geo header arrives: true blocks creation, false allows it.
# AGE_VERIFICATION_FAIL_CLOSED=false

# Yoti: Age Verification API key. Secret.
# AGE_VERIFICATION_API_KEY=

# Yoti: SDK id from the Yoti Hub.
# AGE_VERIFICATION_SDK_ID=

# Yoti: Age Verification API base URL.
# AGE_VERIFICATION_API_URL=https://age.yoti.com

# Yoti: notifications public key (PEM) that every notification signature is checked against.
# AGE_VERIFICATION_NOTIFICATION_PUBLIC_KEY=

# Sandbox only: HMAC secret for the sandbox callback (a dev-only fallback is used when unset).
# AGE_VERIFICATION_WEBHOOK_SECRET=

# Days a successful verification stays valid.
# AGE_VERIFICATION_VALID_DAYS=365

# ── Abuse scanning (addendum §3; see docs/abuse-response.md) ───────────────────────────────────────

# "dev" (labeled, matches nothing real, refused on a live site), "photodna" or "cloudflare".
# SCAN_PROVIDER=dev

# true: nothing the scanner could not check is kept or shown (uploads answer 503, outputs retry).
# SCAN_FAIL_CLOSED=true

# PhotoDNA: subscription key issued after Microsoft's approval. Secret.
# PHOTODNA_API_KEY=

# PhotoDNA: the Match URL exactly as Microsoft issues it.
# PHOTODNA_ENDPOINT=

# Unused: Cloudflare's CSAM Scanning Tool notifies by email only.
# CLOUDFLARE_SCAN_WEBHOOK_SECRET=

# Seconds before one scanner call counts as unavailable.
# SCAN_TIMEOUT_S=30

# Dev scanner only: comma-separated SHA-256 hashes that count as a match, for tests and drills.
# SCAN_DEV_MATCH_HASHES=

# Dev scanner only: true makes every scan unavailable, to rehearse an outage.
# SCAN_DEV_SIMULATE_OUTAGE=false

# ── Installable web app and push (addendum §4) ─────────────────────────────────────────────────────

# Web Push public key; generate the pair once per deployment with `npx web-push generate-vapid-keys`.
# Without the three VAPID values push is off and says so. Rotating the pair drops every subscription.
# VAPID_PUBLIC_KEY=

# Web Push private key. Secret.
# VAPID_PRIVATE_KEY=

# Contact for push services: a mailto: address or an https: URL.
# VAPID_SUBJECT=

# ── Observability ──────────────────────────────────────────────────────────────────────────────────

# Errors are always JSON lines on stdout. When set, each error is also POSTed here as JSON (message,
# stack, route, time; no request bodies, query strings, prompts or media), fire-and-forget. Put
# Sentry or another monitor behind it. Secret when the URL carries a token.
# ERROR_WEBHOOK_URL=

# ── Seed (scripts/seed.ts; private previews and development only) ──────────────────────────────────

# Password for every seeded account. Without it the seed makes a random one and prints it once.
# SEED_PASSWORD=

# ── Docker Compose only (docker-compose.yml) ───────────────────────────────────────────────────────

# Postgres superuser password for the bundled database; required by compose. Generate it (hex).
# POSTGRES_PASSWORD=

# Postgres user and database for the bundled database.
# POSTGRES_USER=hushloom
# POSTGRES_DB=hushloom

# Host port for the web app.
# WEB_PORT=3000

# Image for the optional MinIO service (profile "s3"); MinIO's own images are no longer on Docker Hub.
# MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z

# ── Tests (read by vitest.config.ts and playwright.config.ts; never needed in production) ──────────

# vitest database (migrated by the test setup) and Redis.
# TEST_DATABASE_URL=postgres://playbox@localhost:5432/playbox_test
# TEST_REDIS_URL=redis://localhost:6379/1

# Playwright e2e: port, database (dropped and recreated each run; its name must end in _e2e),
# Redis (flushed each run) and media secret (random per run when unset).
# E2E_PORT=3100
# E2E_DATABASE_URL=postgres://playbox@localhost:5432/playbox_e2e
# E2E_REDIS_URL=redis://localhost:6379/2
# E2E_MEDIA_SIGNING_SECRET=

# Print info and debug log lines during vitest (errors always print).
# LOG_TESTS=
